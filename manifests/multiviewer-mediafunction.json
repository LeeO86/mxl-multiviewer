{
  "name": "mxl-multiviewer",
  "description": "DMF multiviewer MediaFunction (4x input v210 -> 2x2 mosaic)",
  "inputs": [
    { "name": "input_1", "format": "video/v210" },
    { "name": "input_2", "format": "video/v210" },
    { "name": "input_3", "format": "video/v210" },
    { "name": "input_4", "format": "video/v210" }
  ],
  "outputs": [
    { "name": "output", "format": "video/v210" }
  ],
  "config": {
    "mxl_domain": "/dev/shm/mxl",
    "output_width": 1920,
    "output_height": 1080,
    "framerate": "30000/1001",
    "layout": "2x2"
  }
}
