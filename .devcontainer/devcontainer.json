{
    "name": "mxl-multiviewer - Ubuntu 24.04",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "BASE_IMAGE_VERSION": "24.04"
        }
    },
    "runArgs": [
        "--security-opt",
        "apparmor:unconfined"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "mhutchie.git-graph",
                "matepek.vscode-catch2-test-adapter",
                "llvm-vs-code-extensions.vscode-clangd",
                "xaver.clang-format",
                "bierner.markdown-mermaid",
                "rust-lang.rust-analyzer"
            ],
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "editor.inlayHints.enabled": "off",
                "editor.formatOnSave": true,
                "[cpp]": {
                    "editor.defaultFormatter": "xaver.clang-format"
                },
                "rust-analyzer.linkedProjects": [
                    "${workspaceFolder}/Cargo.toml",
                    "${workspaceFolder}/mxl/rust/Cargo.toml"
                ]
            }
        }
    },
    "containerEnv": {
        "NINJA_STATUS": "[%r processes, %f/%t @ %o/s : %es] ",
        "CCACHE_DIR": "${containerWorkspaceFolder}/.cache/ccache",
        "VCPKG_ROOT": "/home/devcontainer/vcpkg"
    },
    "hostRequirements": {
        "gpu": "optional"
    },
    "postCreateCommand": "git submodule update --init --recursive",
    "remoteUser": "devcontainer"
}
